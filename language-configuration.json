{
   "folding": {
      "offSide": true
   },
   "comments": {
      "lineComment": "##",
      "blockComment": [ "###", "###" ],
   },
   "brackets": [
      ["(", ")"],
      ["[", "]"],
      ["{", "}"],
   ],
   "autoCloseBefore": "\"'` \n\t",
   "autoClosingPairs": [
      { "open": "{", "close": "}" },
      { "open": "[", "close": "]" },
      { "open": "(", "close": ")" },
      { "open": "'", "close": "'", "notIn": [ "string", "comment" ] },
      { "open": "\"", "close": "\"", "notIn": [ "string" ] },
      { "open": "\"\"\"", "close": "\"\"\"", "notIn": [ "comment" ] },
      { "open": "###", "close": "###", "notIn": [ "string" ] }
   ],
   "surroundingPairs": [
      ["{", "}"],
      ["[", "]"],
      ["(", ")"],
      ["<", ">"],
      ["'", "'"],
      ["\"", "\""]
   ],
   "colorizedBracketPairs": [
      [ "(", ")" ],
      [ "[", "]" ],
      [ "{", "}" ],
   ],
   "onEnterRules": [
      {
         "beforeText": "^\\s*\\b(return|throw|break|continue|noop)\\b",
         "action": {
            "indent": "outdent"
         }
      },
      {
         "beforeText": "^\\s*(public|private|protected|internal)\\s*$",
         "action": {
            "indent": "indent"
         }
      },
      {
         "beforeText": "^(?!.*[\\(\\[\\{]\\s*$)",
         "afterText": "^\\s*\\b(end)\\b.*$",
         "action": {
            "indent": "indentOutdent"
         }
      },
      {
         "beforeText": "^[\\w\\s]*(?<!(?:abstract|extern)\\s*)\\b(operator|func|construct|destruct|get|set)\\b(?!.*=>)(?!.*[\\(\\[\\{]\\s*$)",
         "action": {
            "indent": "indent"
         }
      },
      {
         "beforeText": "^[\\w\\s]*(?<!(?:extern)\\s*)\\b(enum|class|struct|trait|extends|impl)\\b(?!.*[\\(\\[\\{]\\s*$)",
         "action": {
            "indent": "indent"
         }
      },
      {
         "beforeText": "^\\s*\\b(on|if|else|while|do|for|try|catch|finally|with)\\b(?!.*[\\(\\[\\{]\\s*$)",
         "action": {
            "indent": "indent"
         }
      },
      {
         "beforeText": "([_a-zA-Z\\)\\}\\]])(\\s*->.*)?\\s*=>(?!\\s*(?:[\\(\\[\\{]))\\s*$",
         "action": {
            "indent": "indent"
         }
      }
   ]
}